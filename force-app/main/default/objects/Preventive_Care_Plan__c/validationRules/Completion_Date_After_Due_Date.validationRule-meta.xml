<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Date_After_Due_Date</fullName>
    <active>true</active>
    <description>Prevents completing a care plan before its due date.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Completion_Date__c)),
    NOT(ISBLANK(Due_Date__c)),
    Completion_Date__c &lt; Due_Date__c
)</errorConditionFormula>
    <errorDisplayField>Completion_Date__c</errorDisplayField>
    <errorMessage>Completion Date cannot be earlier than the Due Date.</errorMessage>
</ValidationRule>
