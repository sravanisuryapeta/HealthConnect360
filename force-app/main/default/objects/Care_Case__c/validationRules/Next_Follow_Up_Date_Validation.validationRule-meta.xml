<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Next_Follow_Up_Date_Validation</fullName>
    <active>true</active>
    <description>Ensures the next follow-up date is not earlier than the current date.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Next_Follow_Up_Date__c)),
    Next_Follow_Up_Date__c &lt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Next_Follow_Up_Date__c</errorDisplayField>
    <errorMessage>Next Follow-up Date cannot be in the past.</errorMessage>
</ValidationRule>
